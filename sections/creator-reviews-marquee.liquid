                      {%- when 'threads' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 11.1c-.1-2.2-1.3-3.8-3.7-4.1v-.1c1-.2 1.8-.7 2.3-1.4.6-.8.8-1.8.7-2.9h-2.3c.1.8 0 1.5-.4 2-.5.6-1.3.9-2.4.9h-.1v2.1c.1 0 .2 0 .3 0 2.1.1 3.1 1.2 3.2 3.1-.5-.3-1.1-.5-1.8-.5-2.4 0-4 1.8-4 4.2 0 2.5 1.8 4.3 4.3 4.3 1.6 0 2.9-.6 3.8-1.8.7-1 1.1-2.3 1.2-4.1.1-.5.1-1 .1-1.7zm-3.9 5.2c-1.3 0-2.2-.9-2.2-2.2 0-1.4 1-2.3 2.4-2.3.6 0 1.1.2 1.5.4v.5c0 1.3-.2 2.3-.6 3-.4.6-.8.6-1.1.6z"/></svg>
                      {%- when 'tiktok' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.6 7.8a5.8 5.8 0 01-3.4-1.1v7.2a5.7 5.7 0 11-5.7-5.7c.3 0 .6 0 .9.1v2.9a2.8 2.8 0 100 5.5 2.8 2.8 0 002.8-2.8V2h2.9a5.8 5.8 0 003.4 5.3v.5z"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9S14.5 18.3 12 21c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
                    {%- endcase -%}
                  </span>
                  <span class="crvm__platform-name">{{ platform_label }}</span>
                </div>
              </div>
            {%- endcapture -%}

            {%- if platform_url != blank -%}
              <a
                class="crvm__card"
                href="{{ platform_url }}"
                role="listitem"
                {{ block.shopify_attributes }}
                {% if platform_url contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}
                aria-label="{{ name | default: 'Creator' | escape }} on {{ platform_label }}"
              >
                {{ card_inner }}
              </a>
            {%- else -%}
              <article class="crvm__card" role="listitem" tabindex="0" {{ block.shopify_attributes }}>
                {{ card_inner }}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('crvm-{{ sid }}');
    if (!root) return;

    var wrap = root.querySelector('[data-crvm-wrap]');
    var track = root.querySelector('[data-crvm-track]');
    if (!wrap || !track) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var originals = Array.prototype.slice.call(track.children);
    if (!originals.length) return;

    /* Measure one set width (cards + gaps) */
    function setWidth() {
      var nodes = track.querySelectorAll('[data-crvm-original="1"]');
      if (!nodes.length) nodes = originals;
      var total = 0;
      var gap = parseFloat(getComputedStyle(track).gap) || 0;
      nodes.forEach(function (node, i) {
        total += node.getBoundingClientRect().width;
        if (i < nodes.length - 1) total += gap;
      });
      /* Include trailing gap so loop lands on identical frame */
      total += gap;
      root.style.setProperty('--crvm-loop-distance', total + 'px');
      return total;
    }

    /* Match every card to the tallest content-driven height */
    function equalizeHeights() {
      var cards = track.querySelectorAll('.crvm__card');
      if (!cards.length) return;

      cards.forEach(function (card) {
        card.style.minHeight = '';
        card.style.height = 'auto';
      });

      var maxH = 0;
      originals.forEach(function (card) {
        maxH = Math.max(maxH, card.getBoundingClientRect().height);
      });

      if (maxH > 0) {
        cards.forEach(function (card) {
          card.style.minHeight = Math.ceil(maxH) + 'px';
        });
      }
    }

    /* Duplicate original cards until track covers > 2× viewport (seamless + no gaps) */
    function ensureCopies() {
      if (reduceMotion) {
        equalizeHeights();
        return;
      }

      track.querySelectorAll('[data-crvm-clone]').forEach(function (n) { n.remove(); });

      originals.forEach(function (node) {
        node.setAttribute('data-crvm-original', '1');
      });

      var viewportW = wrap.getBoundingClientRect().width || window.innerWidth;
      var guard = 0;
      while (track.scrollWidth < viewportW * 2.2 && guard < 12) {
        originals.forEach(function (node) {
          var clone = node.cloneNode(true);
          clone.setAttribute('data-crvm-clone', '1');
          clone.setAttribute('aria-hidden', 'true');
          clone.removeAttribute('data-crvm-original');
          clone.tabIndex = -1;
          clone.querySelectorAll('a, button, [tabindex]').forEach(function (el) {
            el.setAttribute('tabindex', '-1');
          });
          track.appendChild(clone);
        });
        guard++;
      }

      /* Ensure at least one full duplicate set for -50%-style looping via pixel distance */
      if (guard === 0) {
        originals.forEach(function (node) {
          var clone = node.cloneNode(true);
          clone.setAttribute('data-crvm-clone', '1');
          clone.setAttribute('aria-hidden', 'true');
          clone.removeAttribute('data-crvm-original');
          clone.tabIndex = -1;
          track.appendChild(clone);
        });
      }

      equalizeHeights();
      setWidth();
      track.classList.add('is-animated');
    }

    /* —— Touch / drag scrubbing —— */
    var startX = 0;
    var currentX = 0;
    var dragging = false;
    var baseTransform = 0;

    function getTranslateX() {
      var style = window.getComputedStyle(track).transform;
      if (!style || style === 'none') return 0;
      var matrix = style.match(/matrix.*\((.+)\)/);
      if (!matrix) return 0;
      var parts = matrix[1].split(',');
      return parseFloat(parts[4]) || 0;
    }

    function onPointerDown(e) {
      if (reduceMotion) return;
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true;
      startX = e.clientX;
      baseTransform = getTranslateX();
      track.classList.add('is-dragging');
      wrap.classList.add('is-dragging');
      track.style.animation = 'none';
      track.style.transform = 'translate3d(' + baseTransform + 'px, 0, 0)';
      wrap.setPointerCapture(e.pointerId);
    }

    function onPointerMove(e) {
      if (!dragging) return;
      currentX = e.clientX - startX;
      track.style.transform = 'translate3d(' + (baseTransform + currentX) + 'px, 0, 0)';
    }

    function onPointerUp(e) {
      if (!dragging) return;
      dragging = false;
      wrap.classList.remove('is-dragging');
      track.classList.remove('is-dragging');
      /* Resume seamless CSS animation from start — instantaneous join via duplicated set */
      track.style.animation = '';
      track.style.transform = '';
      track.classList.add('is-animated');
      try { wrap.releasePointerCapture(e.pointerId); } catch (err) {}
    }

    wrap.addEventListener('pointerdown', onPointerDown, { passive: true });
    wrap.addEventListener('pointermove', onPointerMove, { passive: true });
    wrap.addEventListener('pointerup', onPointerUp);
    wrap.addEventListener('pointercancel', onPointerUp);

    /* Pause while focused for keyboard users */
    track.addEventListener('focusin', function () { track.classList.add('is-paused'); });
    track.addEventListener('focusout', function () { track.classList.remove('is-paused'); });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(ensureCopies, 150);
    });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(ensureCopies);
    } else {
      ensureCopies();
    }

    /* Re-init after images load (card heights/widths can shift) */
    track.querySelectorAll('img').forEach(function (img) {
      if (!img.complete) {
        img.addEventListener('load', function () {
          equalizeHeights();
          setWidth();
        }, { once: true });
      }
    });
  })();
</script>

