{%- comment -%}
  Brand Promise
  Two-column promise section: visual (image or icon grid) + heading/copy.
  Fully configurable via Theme Editor settings + blocks.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign layout_reverse = false
  if section.settings.media_position == 'right'
    assign layout_reverse = true
  endif

  assign icon_count = 0
  for block in section.blocks
    if block.type == 'icon' and block.settings.enabled
      if block.settings.image != blank or block.settings.title != blank
        assign icon_count = icon_count | plus: 1
      endif
    endif
  endfor

  assign show_icon_grid = false
  if section.settings.media_mode == 'icons' and icon_count > 0
    assign show_icon_grid = true
  endif
  if section.settings.media_mode == 'auto' and icon_count > 0
    assign show_icon_grid = true
  endif
-%}

{%- style -%}
  #bpp-{{ sid }} {
    --bpp-bg: {{ section.settings.color_background }};
    --bpp-heading: {{ section.settings.color_heading }};
    --bpp-text: {{ section.settings.color_text }};
    --bpp-label: {{ section.settings.color_label }};
    --bpp-accent: {{ section.settings.color_accent }};
    --bpp-icon-title: {{ section.settings.color_icon_title }};
    --bpp-surface: {{ section.settings.color_surface }};
    --bpp-radius: {{ section.settings.media_radius }}px;
    --bpp-gap: {{ section.settings.column_gap }}px;
    --bpp-container: {% if section.settings.full_width %}100%{% else %}{{ section.settings.container_width }}px{% endif %};
    --bpp-pad-top-d: {{ section.settings.padding_top_desktop }}px;
    --bpp-pad-bottom-d: {{ section.settings.padding_bottom_desktop }}px;
    --bpp-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --bpp-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --bpp-heading-size-d: {{ section.settings.heading_size_desktop }}px;
    --bpp-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --bpp-text-size: {{ section.settings.text_size }}px;
    --bpp-label-size: {{ section.settings.label_size }}px;
    --bpp-icon-title-size: {{ section.settings.icon_title_size }}px;
    --bpp-icon-size: {{ section.settings.icon_size }}px;
    --bpp-media-max: {{ section.settings.media_max_width }}px;
    --bpp-copy-max: {{ section.settings.copy_max_width }}px;
    --bpp-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --bpp-shadow:
      {% case section.settings.shadow_strength %}
        {% when 'none' %}none
        {% when 'soft' %}0 8px 28px rgba(49, 36, 38, 0.04)
        {% when 'medium' %}0 12px 32px rgba(49, 36, 38, 0.06)
        {% when 'strong' %}0 18px 44px rgba(49, 36, 38, 0.09)
      {% endcase %};
  }

  #bpp-{{ sid }} {
    position: relative;
    isolation: isolate;
    background-color: #ffffff;
    padding-top: var(--bpp-pad-top-m);
    padding-bottom: var(--bpp-pad-bottom-m);
    color: var(--bpp-text);
    overflow-x: clip;
    overflow-y: visible;
  }

  /* Soft brand wash — no hard section border */
  #bpp-{{ sid }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, #f6f1f2 35%, transparent) 0%,
        transparent 28%,
        transparent 58%,
        color-mix(in srgb, #f6f1f2 28%, transparent) 100%
      ),
      radial-gradient(
        ellipse 70% 50% at 50% 100%,
        color-mix(in srgb, #ece4e6 40%, transparent),
        transparent 70%
      );
  }

  #bpp-{{ sid }} .bpp__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--bpp-container);
    margin: 0 auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    box-sizing: border-box;
  }

  #bpp-{{ sid }} .bpp__grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  #bpp-{{ sid }} .bpp__media,
  #bpp-{{ sid }} .bpp__copy {
    width: 100%;
  }

  #bpp-{{ sid }} .bpp__media {
    max-width: var(--bpp-media-max);
  }

  #bpp-{{ sid }} .bpp__copy {
    max-width: var(--bpp-copy-max);
    text-align: {{ section.settings.copy_alignment }};
    {% if section.settings.copy_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif section.settings.copy_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  #bpp-{{ sid }} .bpp__label {
    margin: 0 0 0.75rem;
    font-size: var(--bpp-label-size);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bpp-label);
  }

  #bpp-{{ sid }} .bpp__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-style: var(--font-heading-style, normal);
    font-weight: {{ section.settings.heading_weight }};
    font-size: var(--bpp-heading-size-m);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--bpp-heading);
    text-wrap: balance;
  }

  #bpp-{{ sid }} .bpp__text {
    margin: 0;
    font-size: var(--bpp-text-size);
    line-height: 1.7;
    color: var(--bpp-text);
  }

  #bpp-{{ sid }} .bpp__text p {
    margin: 0 0 0.85rem;
  }

  #bpp-{{ sid }} .bpp__text p:last-child {
    margin-bottom: 0;
  }

  #bpp-{{ sid }} .bpp__text strong {
    font-weight: 700;
    color: var(--bpp-heading);
  }

  /* Single promise mark above copy */
  #bpp-{{ sid }} .bpp__promise-mark {
    --bpp-promise-size: {{ section.settings.promise_icon_size | default: 64 }}px;
    display: flex;
    justify-content: {% if section.settings.copy_alignment == 'left' %}flex-start{% elsif section.settings.copy_alignment == 'right' %}flex-end{% else %}center{% endif %};
    margin: 0 0 1.15rem;
  }

  #bpp-{{ sid }} .bpp__promise-mark-inner {
    width: var(--bpp-promise-size);
    height: var(--bpp-promise-size);
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.color_promise_icon | default: '#6F4B53' }};
  }

  #bpp-{{ sid }} .bpp__promise-mark-inner svg,
  #bpp-{{ sid }} .bpp__promise-mark-inner img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  /* —— Single image: layered showcase —— */
  #bpp-{{ sid }} .bpp__image-stage {
    position: relative;
    width: 100%;
    perspective: 1200px;
    padding: 0.85rem 0.75rem 1.25rem;
    box-sizing: border-box;
  }

  #bpp-{{ sid }} .bpp__image-stack {
    position: relative;
    transform-style: preserve-3d;
    {% if section.settings.enable_media_depth %}
      {% if section.settings.media_position == 'right' %}
        transform: rotateY(-5deg) rotateX(2deg);
      {% else %}
        transform: rotateY(5deg) rotateX(2deg);
      {% endif %}
      transition: transform 0.85s var(--bpp-ease);
    {% endif %}
  }

  {% if section.settings.enable_media_depth %}
    #bpp-{{ sid }} .bpp__image-plane {
      position: absolute;
      inset: 0;
      border-radius: calc(var(--bpp-radius) + 4px);
      pointer-events: none;
    }

    #bpp-{{ sid }} .bpp__image-plane--back {
      background: color-mix(in srgb, var(--bpp-accent) 28%, var(--bpp-surface));
      transform: translate3d(
        {% if section.settings.media_position == 'right' %}-14px{% else %}14px{% endif %},
        14px,
        -28px
      );
      box-shadow: 0 18px 40px rgba(28, 22, 16, 0.08);
    }

    #bpp-{{ sid }} .bpp__image-plane--mid {
      background: color-mix(in srgb, var(--bpp-accent) 12%, #fff);
      opacity: 0.65;
      transform: translate3d(
        {% if section.settings.media_position == 'right' %}-7px{% else %}7px{% endif %},
        7px,
        -14px
      );
    }

    @media (hover: hover) {
      #bpp-{{ sid }} .bpp__image-stage:hover .bpp__image-stack {
        transform: rotateY(0deg) rotateX(0deg) translateY(-4px);
      }
    }
  {% else %}
    #bpp-{{ sid }} .bpp__image-plane {
      display: none;
    }
  {% endif %}

  #bpp-{{ sid }} .bpp__image-wrap {
    position: relative;
    z-index: 1;
    border-radius: var(--bpp-radius);
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.55) inset,
      var(--bpp-shadow);
    background: color-mix(in srgb, var(--bpp-accent) 8%, var(--bpp-surface));
    {% case section.settings.image_aspect %}
      {% when 'square' %}
        aspect-ratio: 1 / 1;
      {% when 'portrait' %}
        aspect-ratio: 4 / 5;
      {% when 'landscape' %}
        aspect-ratio: 4 / 3;
      {% else %}
        aspect-ratio: auto;
    {% endcase %}
  }

  #bpp-{{ sid }} .bpp__image-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.22) 0%, transparent 36%, transparent 68%, rgba(28, 22, 16, 0.08) 100%);
    z-index: 1;
  }

  #bpp-{{ sid }} .bpp__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
    display: block;
    {% if section.settings.hover_zoom %}
      transition: transform 1s var(--bpp-ease);
    {% endif %}
  }

  {% if section.settings.hover_zoom %}
    @media (hover: hover) {
      #bpp-{{ sid }} .bpp__image-stage:hover .bpp__image-wrap img {
        transform: scale(1.04);
      }
    }
  {% endif %}

  #bpp-{{ sid }} .bpp__image-placeholder {
    width: 100%;
    min-height: 240px;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bpp-accent);
    opacity: 0.4;
    border-radius: var(--bpp-radius);
    background: color-mix(in srgb, var(--bpp-accent) 10%, var(--bpp-surface));
  }

  /* —— Icon grid: light fill + unique polygonal frames —— */
  #bpp-{{ sid }} .bpp__icons {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    display: grid;
    grid-template-columns: repeat({{ section.settings.icons_per_row_mobile }}, minmax(0, 1fr));
    gap: {{ section.settings.icon_gap }}px;
  }

  #bpp-{{ sid }} .bpp__icon {
    text-align: center;
    margin: 0;
  }

  #bpp-{{ sid }} .bpp__icon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: transparent;
    border: 0;
    box-shadow: none;
    padding: 0.35rem 0.25rem;
    border-radius: 0;
    overflow: visible;
  }

  #bpp-{{ sid }} .bpp__icon-card::before {
    display: none;
  }

  #bpp-{{ sid }} .bpp__icon-glow {
    display: none;
  }

  #bpp-{{ sid }} .bpp__icon-media {
    --bpp-icon-radius: {% if section.settings.icon_shape == 'circle' %}50%{% else %}{{ section.settings.icon_radius }}px{% endif %};
    position: relative;
    z-index: 1;
    width: var(--bpp-icon-size);
    height: var(--bpp-icon-size);
    max-width: 100%;
    margin: 0 auto 0.85rem;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--bpp-icon-radius);
    color: var(--bpp-accent);
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.9), transparent 55%),
      {{ section.settings.color_icon_bg | default: '#F6F1F2' }};
    border: 1px solid rgba(111, 75, 83, 0.18);
    box-shadow:
      inset 0 0 0 4px rgba(255, 255, 255, 0.55),
      0 6px 18px rgba(49, 36, 38, 0.07);
    overflow: visible;
    transition: transform 0.65s var(--bpp-ease), box-shadow 0.65s var(--bpp-ease), border-color 0.65s var(--bpp-ease);
  }

  #bpp-{{ sid }} .bpp__icon-media-inner {
    width: 46%;
    height: 46%;
    border-radius: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    color: inherit;
  }

  #bpp-{{ sid }} .bpp__icon-media-inner:has(img) {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #bpp-{{ sid }} .bpp__icon-media svg {
    width: 100%;
    height: 100%;
    display: block;
    flex-shrink: 0;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  {% if section.settings.enable_media_depth %}
    @media (hover: hover) {
      #bpp-{{ sid }} .bpp__icon:hover .bpp__icon-media {
        transform: translateY(-4px);
        border-color: rgba(111, 75, 83, 0.4);
        box-shadow:
          inset 0 0 0 4px rgba(255, 255, 255, 0.7),
          0 12px 28px rgba(49, 36, 38, 0.12);
      }
    }
  {% endif %}

  #bpp-{{ sid }} .bpp__icon-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--bpp-icon-radius);
  }

  #bpp-{{ sid }} .bpp__icon-title {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: var(--bpp-icon-title-size);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--bpp-icon-title);
  }

  #bpp-{{ sid }} a.bpp__icon-card--link {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  #bpp-{{ sid }} a.bpp__icon-card--link:focus-visible .bpp__icon-media {
    outline: 2px solid var(--bpp-accent);
    outline-offset: 3px;
  }

  /* Animations */
  #bpp-{{ sid }} .bpp-anim {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.8s var(--bpp-ease),
      transform 0.8s var(--bpp-ease);
  }

  #bpp-{{ sid }} .bpp-anim.is-visible {
    opacity: 1;
    transform: none;
  }

  /* Keep trust icons readable even before scroll animation completes */
  #bpp-{{ sid }} .bpp__media.bpp-anim,
  #bpp-{{ sid }} .bpp__icon.bpp-anim {
    opacity: 1;
    transform: none;
  }

  #bpp-{{ sid }} .bpp__icon.bpp-anim {
    transition-delay: calc(var(--bpp-stagger, 0) * 80ms);
  }

  @media (prefers-reduced-motion: reduce) {
    #bpp-{{ sid }} .bpp-anim {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #bpp-{{ sid }} .bpp__image-wrap img,
    #bpp-{{ sid }} .bpp__image-stack,
    #bpp-{{ sid }} .bpp__icon-media {
      transition: none !important;
      transform: none !important;
      animation: none !important;
    }
  }

  @media screen and (min-width: 750px) {
    #bpp-{{ sid }} {
      padding-top: var(--bpp-pad-top-d);
      padding-bottom: var(--bpp-pad-bottom-d);
    }

    #bpp-{{ sid }} .bpp__inner {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    #bpp-{{ sid }} .bpp__grid {
      flex-direction: row;
      align-items: center;
      gap: var(--bpp-gap);
      {% if layout_reverse %}
        flex-direction: row-reverse;
      {% endif %}
    }

    #bpp-{{ sid }} .bpp__media,
    #bpp-{{ sid }} .bpp__copy {
      flex: 1 1 0;
    }

    #bpp-{{ sid }} .bpp__heading {
      font-size: var(--bpp-heading-size-d);
    }

    #bpp-{{ sid }} .bpp__icons {
      grid-template-columns: repeat({{ section.settings.icons_per_row_desktop }}, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    #bpp-{{ sid }} .bpp__inner {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
  }
{%- endstyle -%}

<section
  id="bpp-{{ sid }}"
  class="bpp"
  {% if section.settings.heading != blank %}
    aria-labelledby="bpp-heading-{{ sid }}"
  {% else %}
    aria-label="{{ section.settings.label | default: 'Our promise' | escape }}"
  {% endif %}
  data-bpp-section
>
  <div class="bpp__inner">
    <div class="bpp__grid">
      <div class="bpp__media bpp-anim" data-bpp-anim>
        {%- if show_icon_grid -%}
          <ul class="bpp__icons" role="list">
            {%- assign icon_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'icon' and block.settings.enabled -%}
                {%- if block.settings.image != blank or block.settings.title != blank -%}
                  <li
                    class="bpp__icon bpp-anim"
                    data-bpp-anim
                    style="--bpp-stagger: {{ icon_index }};"
                    {{ block.shopify_attributes }}
                  >
                    {%- liquid
                      assign bpp_wa_link = blank
                      if block.settings.icon_style == 'whatsapp' and settings.whatsapp_phone != blank
                        assign bpp_wa_phone = settings.whatsapp_phone | replace: ' ', '' | replace: '-', '' | replace: '+', '' | replace: '(', '' | replace: ')', ''
                        assign bpp_wa_message = 'Hi! I need help with my order from Srivaya.' | url_encode
                        assign bpp_wa_link = 'https://wa.me/' | append: bpp_wa_phone | append: '?text=' | append: bpp_wa_message
                      endif
                    -%}
                    {%- if bpp_wa_link != blank -%}
                      <a
                        href="{{ bpp_wa_link }}"
                        class="bpp__icon-card bpp__icon-card--link"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="{{ block.settings.title | default: 'Chat on WhatsApp' | escape }}"
                      >
                    {%- else -%}
                      <div class="bpp__icon-card">
                    {%- endif -%}
                      <div class="bpp__icon-media">
                        <div class="bpp__icon-media-inner">
                          {%- if block.settings.image != blank -%}
                            {%- assign icon_alt = block.settings.title | default: section.settings.heading -%}
                            {{
                              block.settings.image
                              | image_url: width: 400
                              | image_tag:
                                loading: 'lazy',
                                decoding: 'async',
                                widths: '120, 200, 300, 400',
                                sizes: '(min-width: 750px) 140px, 30vw',
                                alt: icon_alt
                            }}
                          {%- else -%}
                            {%- case block.settings.icon_style -%}
                              {%- when 'gst' -%}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                  <path d="M9 12l2 2 4-4"></path>
                                </svg>
                              {%- when 'whatsapp' -%}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                  <g transform="translate(3.2 3.2) scale(0.73)">
                                    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"></path>
                                    <path d="M12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.9 11.9 0 0 0 5.69 1.45h.01c6.55 0 11.89-5.34 11.89-11.89A11.82 11.82 0 0 0 12.05 0zm0 21.78h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.43 9.88-9.88 9.88z"></path>
                                  </g>
                                </svg>
                              {%- when 'packaging' -%}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <rect x="3" y="8" width="18" height="13" rx="1.5"></rect>
                                  <path d="M12 8V3.5"></path>
                                  <path d="M8 8l2.5-4h3L16 8"></path>
                                  <circle cx="12" cy="14.5" r="2.25"></circle>
                                </svg>
                              {%- when 'returns' -%}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M4 12a8 8 0 1 0 2.5-5.8"></path>
                                  <polyline points="4 4.5 4 8.5 8 8.5"></polyline>
                                  <polyline points="9.5 12.5 11.5 14.5 16 9.8"></polyline>
                                </svg>
                              {%- when 'shipping' -%}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M12 21s-7-4.35-7-10a7 7 0 1 1 14 0c0 5.65-7 10-7 10z"></path>
                                  <circle cx="12" cy="11" r="2.5"></circle>
                                </svg>
                              {%- when 'photos' -%}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M4 7h3l2-2h6l2 2h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z"></path>
                                  <circle cx="12" cy="13" r="3.5"></circle>
                                </svg>
                              {%- when 'payments' -%}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                  <path d="M2 10h20"></path>
                                </svg>
                              {%- when 'quality' -%}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M12 3l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 15.9l-4.8 2.5.9-5.4-3.9-3.8 5.4-.8L12 3z"></path>
                                </svg>
                              {%- else -%}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                  <path d="M9 12l2 2 4-4"></path>
                                </svg>
                            {%- endcase -%}
                          {%- endif -%}
                        </div>
                      </div>
                      {%- if block.settings.title != blank -%}
                        <p class="bpp__icon-title">{{ block.settings.title | escape }}</p>
                      {%- endif -%}
                    {%- if bpp_wa_link != blank -%}
                      </a>
                    {%- else -%}
                      </div>
                    {%- endif -%}
                  </li>
                  {%- assign icon_index = icon_index | plus: 1 -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- elsif section.settings.image != blank -%}
          <div class="bpp__image-stage">
            <div class="bpp__image-stack">
              {%- if section.settings.enable_media_depth -%}
                <div class="bpp__image-plane bpp__image-plane--back" aria-hidden="true"></div>
                <div class="bpp__image-plane bpp__image-plane--mid" aria-hidden="true"></div>
              {%- endif -%}
              <div class="bpp__image-wrap">
                {%- assign main_alt = section.settings.image_alt | default: section.settings.heading -%}
                {{
                  section.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    widths: '400, 600, 800, 1000, 1200, 1400',
                    sizes: '(min-width: 990px) 520px, (min-width: 750px) 45vw, 90vw',
                    alt: main_alt
                }}
              </div>
            </div>
          </div>
        {%- else -%}
          <div class="bpp__image-placeholder" role="img" aria-label="Promise image placeholder">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <circle cx="8.5" cy="10" r="1.5"/>
              <path d="m21 16-5-4-4 3-3-2-4 3"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

      <div class="bpp__copy">
        {%- if section.settings.show_promise_icon -%}
          <div class="bpp__promise-mark bpp-anim" data-bpp-anim aria-hidden="true">
            <span class="bpp__promise-mark-inner">
              {%- if section.settings.promise_icon_image != blank -%}
                {{
                  section.settings.promise_icon_image
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    widths: '64, 96, 128, 200, 300, 400',
                    sizes: '(min-width: 750px) 96px, 72px',
                    alt: ''
                }}
              {%- else -%}
                {%- case section.settings.promise_icon -%}
                  {%- when 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      <path d="M9 12l2 2 4-4"></path>
                    </svg>
                  {%- when 'check' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M9 12l2 2 4-4"></path>
                    </svg>
                  {%- when 'hand' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 3l2.5 3.5h-5L12 3z"></path>
                      <path d="M9.5 6.5h5L16.5 10 12 20 7.5 10 9.5 6.5z"></path>
                      <path d="M7.5 10h9"></path>
                    </svg>
                  {%- else -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M9 12l2 2 4-4"></path>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}

        {%- if section.settings.label != blank -%}
          <p class="bpp__label bpp-anim" data-bpp-anim>{{ section.settings.label | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 id="bpp-heading-{{ sid }}" class="bpp__heading bpp-anim" data-bpp-anim>
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="bpp__text rte bpp-anim" data-bpp-anim>
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('bpp-{{ sid }}');
    if (!root) return;

    var items = root.querySelectorAll('[data-bpp-anim]');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion || !('IntersectionObserver' in window)) {
      items.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.18, rootMargin: '0px 0px -30px 0px' }
    );

    items.forEach(function (el) { observer.observe(el); });
  })();
</script>

