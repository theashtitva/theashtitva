      "label": "Subtle champagne gold border",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout & style"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 8,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "info": "100px creates a fully pill-shaped look",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Soft shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "desktop_speed",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Desktop animation speed",
      "info": "Higher values = slower, more luxurious motion",
      "default": 55
    },
    {
      "type": "range",
      "id": "mobile_speed",
      "min": 25,
      "max": 140,
      "step": 5,
      "unit": "s",
      "label": "Mobile animation speed",
      "info": "Slightly slower on mobile for comfort",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Priya Sharma"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "Absolutely loved the quality. Looks exactly like real diamonds."
        },
        {
          "type": "image_picker",
          "id": "customer_image",
          "label": "Customer image"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Customer Reviews Marquee",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "customer_name": "Priya Sharma",
            "review_text": "Absolutely loved the quality. Looks exactly like real diamonds."
          }
        },
        {
          "type": "review",
