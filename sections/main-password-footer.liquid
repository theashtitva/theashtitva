<div class="password__footer password__footer--premium color-{{ section.settings.color_scheme }}">
  <p class="password__footer-eyebrow">Follow Ashtitva</p>

  <div class="password__footer-socials">
    {%- if settings.social_instagram_link != blank -%}
      {%- assign ig_handle = settings.social_instagram_link
        | remove: 'https://www.instagram.com/'
        | remove: 'https://instagram.com/'
        | remove: 'http://www.instagram.com/'
        | remove: 'http://instagram.com/'
        | split: '/'
        | first
        | prepend: '@'
      -%}
      <a
        href="{{ settings.social_instagram_link }}"
        class="password-social-card"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="password-social-card__icon svg-wrapper">
          {{- 'icon-instagram.svg' | inline_asset_content -}}
        </span>
        <span class="password-social-card__meta">
          <span class="password-social-card__label">Instagram</span>
          <span class="password-social-card__handle">{{ ig_handle }}</span>
        </span>
      </a>
    {%- endif -%}

    {%- if settings.social_facebook_link != blank -%}
      {%- assign fb_handle = settings.social_facebook_link
        | remove: 'https://www.facebook.com/'
        | remove: 'https://facebook.com/'
        | remove: 'http://www.facebook.com/'
        | remove: 'http://facebook.com/'
        | split: '/'
        | first
      -%}
      <a
        href="{{ settings.social_facebook_link }}"
        class="password-social-card"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="password-social-card__icon svg-wrapper">
          {{- 'icon-facebook.svg' | inline_asset_content -}}
        </span>
        <span class="password-social-card__meta">
          <span class="password-social-card__label">Facebook</span>
          <span class="password-social-card__handle">{{ fb_handle }}</span>
        </span>
      </a>
    {%- endif -%}
  </div>

  {% render 'social-icons', class: 'password__footer-icons', platforms: 'youtube,pinterest,tiktok,twitter' %}

  {% capture shopify %}
    <a
      class="shopify-link"
      href="//www.shopify.com"
      rel="nofollow"
      target="_blank"
      aria-describedby="a11y-new-window-message"
      aria-label="Shopify"
    >
      {{ 'icon-shopify.svg' | inline_asset_content }}
    </a>
  {% endcapture %}
  <small class="password__footer-caption password__footer-text">
    {{- 'general.password_page.powered_by_shopify_html' | t: shopify: shopify -}}
  </small>
  <small class="password__footer-login password__footer-text">{{ 'general.password_page.admin_link_html' | t }}</small>
</div>

{% schema %}
{
  "name": "t:sections.main-password-footer.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
