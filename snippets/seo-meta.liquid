{%- comment -%}
  Builds SEO title + description with brand, misspelling, and Hinglish fallbacks.
  Sets seo_og_title / seo_og_description for meta-tags.
  DAY8-02 — Product title: {{ product.title }} | Ashtitva (no duplicate Ashtitva).
  Product description: first 150 chars of body; exact fallback if empty.
{%- endcomment -%}

{%- liquid
  assign seo_title = page_title | strip
  assign seo_description = page_description | strip
  assign default_home_title = 'Ashtitva: Online Shopping For Fashion Jewellery & Sets'
  assign default_description = 'Shop Ashtitva jewellery online — necklace, earrings, rings aur sets. Real photos, behtareen designs, gift aur festive looks. India delivery.'

  if settings.seo_homepage_title != blank
    assign default_home_title = settings.seo_homepage_title
  endif
  if settings.seo_default_description != blank
    assign default_description = settings.seo_default_description
  endif
  if settings.seo_homepage_description != blank
    assign homepage_description = settings.seo_homepage_description
  else
    assign homepage_description = default_description
  endif

  assign description_is_weak = false
  if seo_description == blank or seo_description == 'Welcome to our store' or seo_description == 'Welcome to our store.'
    assign description_is_weak = true
  endif

  if request.page_type == 'index'
    if settings.seo_homepage_title != blank
      assign seo_title = settings.seo_homepage_title
    elsif seo_title == blank or seo_title == shop.name
      assign seo_title = default_home_title
    endif

    if settings.seo_homepage_description != blank
      assign seo_description = homepage_description
      assign description_is_weak = false
    elsif description_is_weak
      assign seo_description = homepage_description
      assign description_is_weak = false
    endif
  endif

  if request.page_type == 'collection'
    capture sitelink_title
      render 'seo-collection-copy', collection: collection, field: 'title'
    endcapture
    capture sitelink_description
      render 'seo-collection-copy', collection: collection, field: 'description'
    endcapture
    assign sitelink_title = sitelink_title | strip
    assign sitelink_description = sitelink_description | strip

    if sitelink_title != blank
      assign seo_title = sitelink_title
    endif
    if sitelink_description != blank
      assign seo_description = sitelink_description
      assign description_is_weak = false
    endif
  endif

  if request.page_type == 'product'
    assign product_title_stripped = product.title | strip
    if page_title != blank and page_title != product.title
      assign seo_title = page_title | strip
    else
      assign title_tail = product_title_stripped | slice: -8, 8 | downcase
      if title_tail == 'ashtitva'
        assign seo_title = product_title_stripped
      else
        assign seo_title = product_title_stripped | append: ' | Ashtitva'
      endif
    endif

    assign product_desc_plain = product.description | strip_html | strip_newlines | strip
    if product_desc_plain != blank
      assign seo_description = product_desc_plain | truncate: 150, ''
    else
      assign seo_description = 'Shop ' | append: product.title | append: ' at Ashtitva. Real product photos, American Diamond jewellery, prepaid shipping across India.'
    endif
    assign description_is_weak = false
  endif

  if description_is_weak
    if request.page_type == 'collection'
      case collection.handle
        when 'best-seller'
          assign seo_description = 'Shop Ashtitva bestsellers — most-loved necklace, earrings, rings aur sets. Real photos, behtareen designs. India delivery.'
        when 'earrings'
          assign seo_description = 'Earrings online at Ashtitva — daily, party aur festive styles. Real photos, stylish designs, India delivery.'
        when 'necklace'
          assign seo_description = 'Necklace aur necklace set online at Ashtitva. Daily wear se festive tak — real photos, behtareen designs.'
        when 'rings'
          assign seo_description = 'Rings for daily wear, gifting aur celebration at Ashtitva. Real photos, stylish designs, India delivery.'
        when 'kada'
          assign seo_description = 'Kada aur bracelet designs at Ashtitva for everyday aur festive wear. Comfortable, stylish, real photos.'
        else
          if collection.description != blank
            assign seo_description = collection.description | strip_html | strip | truncate: 155
          else
            assign seo_description = 'Shop ' | append: collection.title | append: ' at Ashtitva — fashion jewellery with real photos. Necklace, earrings, rings aur sets. India delivery.'
          endif
      endcase
    elsif request.page_type == 'list-collections'
      assign seo_title = 'Categories | Ashtitva Fashion Jewellery'
      assign seo_description = 'Browse Ashtitva jewellery — Silver Elegance, Gold Glam, Rose Gold, Luxe Picks, Rare Find, necklace, earrings aur more.'
    elsif request.page_type == 'page'
      case page.handle
        when 'about-us'
          assign seo_description = 'Ashtitva jewellery that celebrates you. Real photos, thoughtful curation. Official store: ashtitva.com.'
        when 'contact'
          assign seo_description = 'Contact Ashtitva on WhatsApp, phone or email. Hum help karenge aapka piece find karne mein.'
        when 'faq'
          assign seo_description = 'Ashtitva FAQ — shipping, returns, photos aur ordering. Shop with confidence at ashtitva.com.'
        else
          if page.content != blank
            assign seo_description = page.content | strip_html | strip | truncate: 155
          else
            assign seo_description = default_description
          endif
      endcase
    elsif request.page_type == 'article' and article.excerpt_or_content != blank
      assign seo_description = article.excerpt_or_content | strip_html | strip | truncate: 155
    elsif shop.description != blank and shop.description != 'Welcome to our store' and shop.description != 'Welcome to our store.'
      assign seo_description = shop.description | strip_html | strip | truncate: 155
    else
      assign seo_description = default_description
    endif
  endif

  assign seo_og_title = seo_title
  assign seo_og_description = seo_description
-%}

<title>
  {{ seo_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- if request.page_type != 'index' and request.page_type != 'product' -%}
    {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endif -%}
</title>
<meta name="description" content="{{ seo_description | escape }}">

{%- if request.page_type == 'cart' or request.page_type == 'search' or request.page_type == 'password' -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}
