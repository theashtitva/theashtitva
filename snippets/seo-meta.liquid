{%- comment -%}
  Builds SEO title + description with brand fallbacks.
  Sets seo_og_title / seo_og_description for meta-tags.
{%- endcomment -%}

{%- liquid
  assign seo_title = page_title | strip
  assign seo_description = page_description | strip
  assign default_home_title = 'Ashtitva | Necklaces, Earrings & Fashion Jewellery Online'
  assign default_description = 'Find the piece that celebrates you. Shop Ashtitva fashion necklaces, earrings, rings and sets with real product photos, thoughtfully curated and delivered across India.'

  if settings.seo_homepage_title != blank
    assign default_home_title = settings.seo_homepage_title
  endif
  if settings.seo_default_description != blank
    assign default_description = settings.seo_default_description
  endif
  if settings.seo_homepage_description != blank
    assign homepage_description = settings.seo_homepage_description
  else
    assign homepage_description = default_description
  endif

  assign description_is_weak = false
  if seo_description == blank or seo_description == 'Welcome to our store' or seo_description == 'Welcome to our store.'
    assign description_is_weak = true
  endif

  if request.page_type == 'index'
    if settings.seo_homepage_title != blank
      assign seo_title = settings.seo_homepage_title
    elsif seo_title == blank or seo_title == shop.name
      assign seo_title = default_home_title
    endif

    if settings.seo_homepage_description != blank
      assign seo_description = homepage_description
      assign description_is_weak = false
    elsif description_is_weak
      assign seo_description = homepage_description
      assign description_is_weak = false
    endif
  endif

  if description_is_weak
    if request.page_type == 'product' and product.description != blank
      assign seo_description = product.description | strip_html | strip | truncate: 155
    elsif request.page_type == 'collection'
      case collection.handle
        when 'best-seller'
          assign seo_description = 'Shop Ashtitva bestsellers: loved necklaces, earrings, rings and sets chosen for everyday beauty and style ready for celebration.'
        when 'earrings'
          assign seo_description = 'Express your individuality with Ashtitva earrings. Explore everyday, festive and statement styles with real product photography.'
        when 'necklace'
          assign seo_description = 'Discover Ashtitva necklaces crafted to celebrate you, from everyday layers to festive statement pieces with real product photos.'
        when 'rings'
          assign seo_description = 'Find rings that feel like you. Shop Ashtitva fashion rings for gifting, celebrations and everyday wear across India.'
        when 'kada'
          assign seo_description = 'Shop Ashtitva kadas and bracelets designed for comfort, presence and celebration, with real photos, shipping across India.'
        when 'gold-glam'
          assign seo_description = 'Explore Ashtitva Gold Glam jewellery: radiant necklaces, earrings and sets that bring warmth and polish to every look.'
        when 'silver-elegance'
          assign seo_description = 'Shop Ashtitva Silver Elegance pieces: refined jewellery for everyday beauty, gifting and quiet celebration.'
        when 'rose-gold'
          assign seo_description = 'Discover Ashtitva rose gold jewellery: soft, romantic finishes for necklaces, earrings and sets that feel personal.'
        else
          if collection.description != blank
            assign seo_description = collection.description | strip_html | strip | truncate: 155
          else
            assign seo_description = 'Shop the ' | append: collection.title | append: ' collection at Ashtitva: fashion jewellery with real product photos, made to celebrate you.'
          endif
      endcase
    elsif request.page_type == 'list-collections'
      assign seo_title = 'Categories | Ashtitva Fashion Jewellery'
      assign seo_description = 'Browse Ashtitva jewellery categories: necklaces, earrings, rings, kadas and curated collections for every celebration.'
    elsif request.page_type == 'page'
      case page.handle
        when 'about-us'
          assign seo_description = 'We are an amalgamation of thoughtful design and authentic photography. Learn why Ashtitva jewellery is made to celebrate you.'
        when 'contact'
          assign seo_description = 'Talk to Ashtitva on WhatsApp, phone or email. We are here to help you find the piece that feels like you.'
        when 'faq'
          assign seo_description = 'Answers on shipping, returns, product care and ordering at Ashtitva, so you can shop fashion jewellery with confidence.'
        else
          if page.content != blank
            assign seo_description = page.content | strip_html | strip | truncate: 155
          else
            assign seo_description = default_description
          endif
      endcase
    elsif request.page_type == 'article' and article.excerpt_or_content != blank
      assign seo_description = article.excerpt_or_content | strip_html | strip | truncate: 155
    elsif shop.description != blank and shop.description != 'Welcome to our store' and shop.description != 'Welcome to our store.'
      assign seo_description = shop.description | strip_html | strip | truncate: 155
    else
      assign seo_description = default_description
    endif
  endif

  assign seo_og_title = seo_title
  assign seo_og_description = seo_description
-%}

<title>
  {{ seo_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- if request.page_type != 'index' -%}
    {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endif -%}
</title>
<meta name="description" content="{{ seo_description | escape }}">

{%- if request.page_type == 'cart' or request.page_type == 'search' or request.page_type == 'password' -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}
