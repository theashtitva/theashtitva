{% comment %}
  PDP stylist WhatsApp + product-type fit notes.
{% endcomment %}
{%- liquid
  assign stylist_phone = '917777877253'
  assign product_abs_url = request.origin | append: product.url
  assign stylist_message = 'Hi Ashtitva! I have a question about ' | append: product.title | append: ' (' | append: product_abs_url | append: ').'
  assign stylist_message_encoded = stylist_message | url_encode
  assign stylist_url = 'https://wa.me/' | append: stylist_phone | append: '?text=' | append: stylist_message_encoded

  assign ptype = product.type | downcase | strip
  assign fit_note = ''
  if ptype == 'ring' or ptype == 'rings'
    assign fit_note = 'Most Ashtitva rings are adjustable. If you need help with fit, WhatsApp us a photo of your finger with a coin for scale.'
  elsif ptype == 'kada' or ptype == 'kadas'
    assign fit_note = 'Many kadas are openable/adjustable for comfortable wear. Check Product Details for openable vs fixed.'
  elsif ptype == 'necklace set' or ptype == 'necklace sets' or ptype contains 'necklace set'
    assign fit_note = 'Necklace length is adjustable on most styles. See Product Details for closure type.'
  endif
-%}

<div class="pdp-stylist">
  <a
    class="pdp-stylist__link"
    href="{{ stylist_url }}"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="pdp-stylist__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" focusable="false">
        <path d="M12.04 2C6.58 2 2.15 6.4 2.15 11.84c0 1.99.59 3.84 1.61 5.4L2 22l4.92-1.7a9.86 9.86 0 0 0 5.12 1.4h.01c5.46 0 9.89-4.4 9.89-9.84C21.94 6.4 17.5 2 12.04 2zm5.75 13.99c-.24.68-1.4 1.24-1.93 1.32-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.26-4.79-4.18-4.94-4.37-.14-.2-1.2-1.6-1.2-3.05 0-1.45.76-2.16 1.03-2.45.27-.29.59-.36.79-.36h.57c.18 0 .43-.07.67.51.24.6.82 2.07.89 2.22.07.15.12.32.02.52-.1.2-.15.32-.3.5-.14.17-.3.38-.43.51-.14.14-.29.29-.12.57.16.28.72 1.19 1.55 1.93 1.06.95 1.96 1.25 2.24 1.39.28.14.44.12.6-.07.17-.2.7-.81.88-1.09.19-.28.37-.23.63-.14.26.1 1.64.77 1.92.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/>
      </svg>
    </span>
    <span class="pdp-stylist__text">Ask a stylist on WhatsApp</span>
  </a>
  {%- if fit_note != blank -%}
    <p class="pdp-stylist__fit">{{ fit_note }}</p>
  {%- endif -%}
</div>
