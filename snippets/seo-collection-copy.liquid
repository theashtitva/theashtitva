  {%- when 'luxe-picks' -%}
    {%- if field == 'title' -%}Luxe Picks{%- else -%}Shop Luxe Picks at Ashtitva — statement jewellery for special days. Premium look, real photos, India shipping.{%- endif -%}
  {%- when 'rare-finds' -%}
