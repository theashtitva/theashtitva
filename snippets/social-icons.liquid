{% comment %}
  Renders social icons from Theme settings → Social media.
  Edit links once there; they apply site-wide.

  Accepts:
  - class: {String} optional class on the <ul>
  - link_class: {String} optional extra class on each <a>
  - platforms: {String} optional comma-separated list to limit platforms
      (facebook,instagram,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo).
      Blank = show all configured platforms.

  Usage:
  {% render 'social-icons' %}
  {% render 'social-icons', class: 'footer__list-social' %}
  {% render 'social-icons', class: 'sv-socials', link_class: 'sv-social' %}
{% endcomment %}

{%- liquid
  assign platforms_filter = platforms | default: '' | downcase | strip
  assign show_all = true
  if platforms_filter != blank
    assign show_all = false
  endif
-%}

<ul class="list-unstyled list-social{% if class %} {{ class }}{% endif %}" role="list">
  {%- if settings.social_facebook_link != blank -%}
    {%- if show_all or platforms_filter contains 'facebook' -%}
      <li class="list-social__item">
        <a
          href="{{ settings.social_facebook_link }}"
          class="link list-social__link{% if link_class %} {{ link_class }}{% endif %}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="svg-wrapper">
            {{- 'icon-facebook.svg' | inline_asset_content -}}
          </span>
          <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
        </a>
      </li>
    {%- endif -%}
  {%- endif -%}

