{% doc %}
  @prompt
    Create a high-converting product feature section with a two-column layout. Left column: a large product/lifestyle image. Right column: a headline, a subtitle tagline below it, a CTA button, and a vertical list of 5 feature bullet points each with a small icon on the left and a short description. The section should have a clean, minimal design with a light/white background. All text, image, button label, and feature items should be customizable via theme editor settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-feature-split-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-product-feature-split__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-feature-split__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-product-feature-split__image-column-{{ ai_gen_id }} {
    {% if block.settings.image_position == 'right' %}
      order: 2;
    {% endif %}
  }

  .ai-product-feature-split__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-feature-split__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-product-feature-split__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-product-feature-split__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-feature-split__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-product-feature-split__content-column-{{ ai_gen_id }} {
    {% if block.settings.image_position == 'right' %}
      order: 1;
    {% endif %}
  }

  .ai-product-feature-split__content-{{ ai_gen_id }} {
    max-width: 600px;
    {% if block.settings.image_position == 'right' %}
      margin-left: 0;
      margin-right: auto;
    {% else %}
      margin-left: auto;
      margin-right: 0;
    {% endif %}
  }

  .ai-product-feature-split__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 600;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.headline_spacing }}px;
    line-height: 1.2;
  }

  .ai-product-feature-split__tagline-{{ ai_gen_id }} {
    font-size: {{ block.settings.tagline_size }}px;
    color: {{ block.settings.tagline_color }};
    margin: 0 0 {{ block.settings.tagline_spacing }}px;
    line-height: 1.5;
  }

  .ai-product-feature-split__cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    transition: background-color 0.3s ease;
    margin-bottom: {{ block.settings.button_spacing }}px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-product-feature-split__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-product-feature-split__features-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.feature_spacing }}px;
  }

  .ai-product-feature-split__feature-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_spacing }}px;
  }

  .ai-product-feature-split__feature-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
    margin-top: 2px;
  }

  .ai-product-feature-split__feature-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-product-feature-split__feature-text-{{ ai_gen_id }} {
    flex: 1;
    font-size: {{ block.settings.feature_font_size }}px;
    color: {{ block.settings.feature_text_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 768px) {
    .ai-product-feature-split__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-product-feature-split__image-column-{{ ai_gen_id }},
    .ai-product-feature-split__content-column-{{ ai_gen_id }} {
      order: unset;
    }

    .ai-product-feature-split__content-{{ ai_gen_id }} {
      margin-left: 0;
      margin-right: 0;
      max-width: 100%;
    }

    .ai-product-feature-split__headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.8);
    }

    .ai-product-feature-split__tagline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.tagline_size }}px * 0.9);
    }
  }
{% endstyle %}

<product-feature-split-{{ ai_gen_id }} class="ai-product-feature-split-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-feature-split__container-{{ ai_gen_id }}">
    <div class="ai-product-feature-split__grid-{{ ai_gen_id }}">
      <div class="ai-product-feature-split__image-column-{{ ai_gen_id }}">
        <div class="ai-product-feature-split__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-product-feature-split__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-product-feature-split__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-apparel-1' | placeholder_svg_tag }}
              <div class="ai-product-feature-split__empty-state-{{ ai_gen_id }}">
                Add a product or lifestyle image
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-product-feature-split__content-column-{{ ai_gen_id }}">
        <div class="ai-product-feature-split__content-{{ ai_gen_id }}">
          {% if block.settings.headline != blank %}
            <h2 class="ai-product-feature-split__headline-{{ ai_gen_id }}">
              {{ block.settings.headline }}
            </h2>
          {% endif %}

          {% if block.settings.tagline != blank %}
            <div class="ai-product-feature-split__tagline-{{ ai_gen_id }}">
              {{ block.settings.tagline }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="ai-product-feature-split__cta-{{ ai_gen_id }}"
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}

          <ul class="ai-product-feature-split__features-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              {% liquid
                assign feature_text_key = 'feature_' | append: i | append: '_text'
                assign feature_icon_key = 'feature_' | append: i | append: '_icon'
                assign feature_text = block.settings[feature_text_key]
                assign feature_icon = block.settings[feature_icon_key]
              %}

              {% if feature_text != blank %}
                <li class="ai-product-feature-split__feature-item-{{ ai_gen_id }}">
                  <div class="ai-product-feature-split__feature-icon-{{ ai_gen_id }}">
                    {% if feature_icon == 'check' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    {% elsif feature_icon == 'star' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% elsif feature_icon == 'heart' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    {% elsif feature_icon == 'shield' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      </svg>
                    {% elsif feature_icon == 'diamond' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2.7 10.3a2.41 2.41 0 0 0 0 3.41l7.59 7.59a2.41 2.41 0 0 0 3.41 0l7.59-7.59a2.41 2.41 0 0 0 0-3.41l-7.59-7.59a2.41 2.41 0 0 0-3.41 0L2.7 10.3z"></path>
                      </svg>
                    {% elsif feature_icon == 'truck' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                      </svg>
                    {% elsif feature_icon == 'award' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="7"></circle>
                        <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                      </svg>
                    {% else %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    {% endif %}
                  </div>
                  <div class="ai-product-feature-split__feature-text-{{ ai_gen_id }}">
                    {{ feature_text }}
                  </div>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</product-feature-split-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductFeatureSplit{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('product-feature-split-{{ ai_gen_id }}', ProductFeatureSplit{{ ai_gen_id }});
  })();
</script>

