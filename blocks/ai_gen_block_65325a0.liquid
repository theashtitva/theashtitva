{% doc %}
  Premium About Us — Ashtitva. Editorial layout aligned to homepage brand system.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .sv-about-{{ ai_gen_id }} {
    --sv-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --sv-ink: var(--ash-heading, #18302a);
    --sv-body: var(--ash-body, #3a4f48);
    --sv-accent: var(--ashtitva-gold, #b89a5a);
    --sv-accent-deep: var(--ash-gold-antique, #9a7f48);
    --sv-soft: var(--ashtitva-ivory-soft, #fcfaf4);
    --sv-ivory: var(--ashtitva-ivory, #f7f3e9);
    --sv-pale: var(--ash-sand, #efe8d8);
    --sv-line: var(--ash-border, #e6dfd0);
    --sv-forest: var(--ashtitva-green, #123c32);
    --sv-forest-deep: var(--ashtitva-green-dark, #0b2924);
    --sv-on-dark: var(--ashtitva-ivory, #f7f3e9);
    --sv-white: #ffffff;
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    color: var(--sv-body);
    background: var(--sv-ivory);
  }

  .sv-about-{{ ai_gen_id }} .sv-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s var(--sv-ease), transform 0.7s var(--sv-ease);
  }

  .sv-about-{{ ai_gen_id }} .sv-reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-about-{{ ai_gen_id }} .sv-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-wrap {
      padding-left: 48px;
      padding-right: 48px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-eyebrow {
    display: block;
    margin: 0 0 0.8rem;
    font-family: var(--ash-font-body, var(--font-body-family));
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sv-accent);
    line-height: 1.3;
  }

  .sv-about-{{ ai_gen_id }} .sv-eyebrow--solo::before,
  .sv-about-{{ ai_gen_id }} .sv-eyebrow--solo::after,
  .sv-about-{{ ai_gen_id }} .sv-eyebrow--left::before {
    display: none;
  }

  .sv-about-{{ ai_gen_id }} .sv-eyebrow--left {
    text-align: left;
  }

  .sv-about-{{ ai_gen_id }} .sv-heading {
    margin: 0;
    font-family: var(--ash-font-display, var(--font-heading-family));
    font-style: var(--font-heading-style, normal);
    font-weight: 400;
    font-size: 2.8rem;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-heading {
      font-size: 4rem;
    }
  }

  /* ——— Hero ——— */
  .sv-about-{{ ai_gen_id }} .sv-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    text-align: center;
    padding: 72px 24px 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--sv-accent) 7%, var(--sv-soft)) 0%,
        var(--sv-soft) 48%,
        color-mix(in srgb, #ffffff 55%, var(--sv-soft)) 100%
      );
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-hero {
      padding: 96px 48px 0;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-title {
    margin: 0 0 1rem;
    font-family: var(--ash-font-display, var(--font-heading-family));
    font-weight: 400;
    font-size: 3.2rem;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-hero-title {
      font-size: 4.8rem;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-text {
    margin: 0 auto;
    max-width: 42rem;
    font-size: 1.5rem;
    line-height: 1.6;
    color: var(--sv-body);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-hero-text {
      font-size: 1.6rem;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-rule {
    display: none;
  }

  /* Promise strip — Loved · Confident · Beautiful · Celebrated */
  .sv-about-{{ ai_gen_id }} .sv-promise {
    max-width: 920px;
    margin: 36px auto 0;
    padding: 28px 8px 40px;
    border-top: 1px solid var(--sv-line);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 12px;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-promise {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 36px 0 52px;
      gap: 0;
    }

    .sv-about-{{ ai_gen_id }} .sv-promise-item:not(:last-child) {
      border-right: 1px solid var(--sv-line);
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-promise-item {
    text-align: center;
    padding: 0 12px;
  }

  .sv-about-{{ ai_gen_id }} .sv-promise-word {
    margin: 0 0 6px;
    font-family: var(--ash-font-display, var(--font-heading-family));
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--sv-ink);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-promise-word {
      font-size: 2.2rem;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-promise-note {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--sv-body);
  }

  /* Trust strip under hero */
  .sv-about-{{ ai_gen_id }} .sv-trust {
    display: none;
  }

  /* ——— Story (editorial split) ——— */
  .sv-about-{{ ai_gen_id }} .sv-story {
    padding: 56px 0 64px;
    background: var(--sv-ivory);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-story {
      padding: 72px 0 88px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    width: 100%;
    max-width: 100%;
    align-items: start;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-story-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
      gap: 56px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-story-aside {
    position: relative;
    min-width: 0;
    align-self: start;
  }

  .sv-about-{{ ai_gen_id }} .sv-story .sv-heading {
    margin-bottom: 0;
  }

  .sv-about-{{ ai_gen_id }} .sv-story-lead {
    margin: 12px 0 0;
    max-width: 100%;
    font-size: 1.5rem;
    line-height: 1.55;
    color: var(--sv-accent);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-story-lead {
      margin-top: 16px;
      max-width: 320px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-story-body {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-wrap: break-word;
    font-family: var(--ash-font-body, var(--font-body-family));
    font-size: 1.55rem;
    line-height: 1.75;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-story-body p {
    margin: 0 0 18px;
  }

  .sv-about-{{ ai_gen_id }} .sv-story-body p:last-child {
    margin-bottom: 0;
  }

  /* ——— Why (4 features, no cards) ——— */
  .sv-about-{{ ai_gen_id }} .sv-why {
    padding: 64px 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--sv-accent) 7%, var(--sv-soft)) 0%,
        var(--sv-soft) 48%,
        color-mix(in srgb, #ffffff 55%, var(--sv-soft)) 100%
      );
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-why {
      padding: 80px 0;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-why-head {
    text-align: center;
    max-width: 520px;
    margin: 0 auto 40px;
  }

  .sv-about-{{ ai_gen_id }} .sv-why-head .sv-eyebrow {
    text-align: center;
  }

  .sv-about-{{ ai_gen_id }} .sv-why-head .sv-eyebrow::before,
  .sv-about-{{ ai_gen_id }} .sv-why-head .sv-eyebrow::after {
    display: none;
  }

  .sv-about-{{ ai_gen_id }} .sv-why-head .sv-heading {
    margin-bottom: 12px;
  }

  .sv-about-{{ ai_gen_id }} .sv-why-intro {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.6;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    max-width: 880px;
    margin: 0 auto;
    border-top: 1px solid var(--sv-line);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-feature {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    align-items: start;
    padding: 28px 4px;
    border-bottom: 1px solid var(--sv-line);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-feature {
      padding: 32px 28px 32px 8px;
    }

    .sv-about-{{ ai_gen_id }} .sv-feature:nth-child(odd) {
      border-right: 1px solid var(--sv-line);
      padding-right: 36px;
    }

    .sv-about-{{ ai_gen_id }} .sv-feature:nth-child(even) {
      padding-left: 36px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-feature-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-feature-icon svg {
    width: 22px;
    height: 22px;
  }

  .sv-about-{{ ai_gen_id }} .sv-feature-title {
    margin: 0 0 6px;
    font-family: var(--ash-font-display, var(--font-heading-family));
    font-weight: 400;
    font-size: 2rem;
    letter-spacing: -0.02em;
    color: var(--sv-ink);
  }

  .sv-about-{{ ai_gen_id }} .sv-feature-text {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.55;
    color: var(--sv-body);
  }

  /* ——— Mission band ——— */
  .sv-about-{{ ai_gen_id }} .sv-mission {
    padding: 72px 24px;
    text-align: center;
    background: var(--sv-forest);
    color: var(--sv-on-dark);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-mission {
      padding: 96px 48px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-mission-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .sv-about-{{ ai_gen_id }} .sv-mission .sv-eyebrow {
    text-align: center;
    color: var(--ash-gold-light, #d8c38f);
  }

  .sv-about-{{ ai_gen_id }} .sv-mission .sv-eyebrow::before,
  .sv-about-{{ ai_gen_id }} .sv-mission .sv-eyebrow::after {
    display: none;
  }

  .sv-about-{{ ai_gen_id }} .sv-mission-quote {
    margin: 0;
    font-family: var(--ash-font-display, var(--font-heading-family));
    font-weight: 400;
    font-size: 2.8rem;
    font-style: normal;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--sv-on-dark);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-mission-quote {
      font-size: 3.6rem;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-mission-body {
    margin: 24px auto 0;
    max-width: 560px;
    font-size: 1.5rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--sv-on-dark) 88%, transparent);
  }

  /* ——— Founder / belief panel ——— */
  .sv-about-{{ ai_gen_id }} .sv-founder {
    padding: 56px 0;
    background: var(--sv-ivory);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-founder {
      padding: 72px 0 88px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-panel {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 28px 36px;
    background: var(--sv-soft);
    border: 1px solid var(--sv-line);
    border-radius: 4px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-founder-panel {
      padding: 48px 52px 44px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-label {
    margin: 0 0 20px;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-quote {
    margin: 0 0 24px;
    font-family: var(--ash-font-display, var(--font-heading-family));
    font-size: 2.2rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-founder-quote {
      font-size: 2.6rem;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-attr {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--sv-body);
  }

  /* ——— Reassure (WhatsApp) ——— */
  .sv-about-{{ ai_gen_id }} .sv-reassure {
    padding: 64px 24px;
    text-align: center;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--sv-accent) 7%, var(--sv-soft)) 0%,
        var(--sv-soft) 48%,
        color-mix(in srgb, #ffffff 55%, var(--sv-soft)) 100%
      );
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-reassure {
      padding: 80px 48px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure .sv-eyebrow {
    text-align: center;
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure .sv-eyebrow::before,
  .sv-about-{{ ai_gen_id }} .sv-reassure .sv-eyebrow::after {
    display: none;
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure-title {
    margin: 0 0 16px;
    font-family: var(--ash-font-display, var(--font-heading-family));
    font-weight: 400;
    font-size: 2.8rem;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-reassure-title {
      font-size: 4rem;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure-text {
    margin: 0 auto 28px;
    max-width: 42rem;
    font-size: 1.5rem;
    line-height: 1.6;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 4.6rem;
    padding: 14px 28px;
    background: transparent;
    color: var(--sv-ink);
    border: 1px solid var(--sv-accent);
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--ash-font-body, var(--font-body-family));
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.28s var(--sv-ease), color 0.28s var(--sv-ease), border-color 0.28s var(--sv-ease);
  }

  .sv-about-{{ ai_gen_id }} .sv-wa-btn svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  @media (hover: hover) {
    .sv-about-{{ ai_gen_id }} .sv-wa-btn:hover {
      background: var(--sv-forest);
      color: var(--sv-on-dark);
      border-color: var(--sv-forest);
    }
  }

  /* ——— Close: CTA + social ——— */
  .sv-about-{{ ai_gen_id }} .sv-close {
    text-align: center;
    padding: 72px 24px 88px;
    background: var(--sv-ivory);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-close {
      padding: 96px 48px 110px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-close-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .sv-about-{{ ai_gen_id }} .sv-close .sv-eyebrow {
    text-align: center;
    margin-bottom: 0.8rem;
  }

  .sv-about-{{ ai_gen_id }} .sv-close .sv-eyebrow::before,
  .sv-about-{{ ai_gen_id }} .sv-close .sv-eyebrow::after {
    display: none;
  }

  .sv-about-{{ ai_gen_id }} .sv-close .sv-heading {
    margin-bottom: 14px;
  }

  .sv-about-{{ ai_gen_id }} .sv-close-text {
    max-width: 42rem;
    margin: 0 auto 32px;
    font-size: 1.5rem;
    line-height: 1.6;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-close-rule {
    display: none;
  }

  .sv-about-{{ ai_gen_id }} .sv-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 4.6rem;
    min-width: 220px;
    padding: 16px 32px;
    background: var(--sv-forest);
    color: var(--sv-on-dark);
    border: 1px solid var(--sv-forest);
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--ash-font-body, var(--font-body-family));
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.28s var(--sv-ease), border-color 0.28s var(--sv-ease);
  }

  .sv-about-{{ ai_gen_id }} .sv-cta-btn svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    transition: transform 0.3s var(--sv-ease);
  }

  @media (hover: hover) {
    .sv-about-{{ ai_gen_id }} .sv-cta-btn:hover {
      background: var(--sv-forest-deep);
      border-color: var(--sv-forest-deep);
    }

    .sv-about-{{ ai_gen_id }} .sv-cta-btn:hover svg {
      transform: translateX(3px);
    }
  }

  .sv-about-{{ ai_gen_id }} .list-social.sv-socials {
    --social-hit-size: 56px;
    --social-icon-size: calc(56px * 0.42);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin: 40px auto 0;
    width: 100%;
  }

  .sv-about-{{ ai_gen_id }} .list-social.sv-socials .list-social__link,
  .sv-about-{{ ai_gen_id }} .sv-social {
    width: var(--social-hit-size);
    height: var(--social-hit-size);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background-color: var(--sv-soft);
    border: 1px solid var(--sv-line);
    border-radius: 50%;
    color: var(--sv-forest);
    text-decoration: none;
    box-shadow: none;
    transition:
      transform 0.4s var(--sv-ease),
      background-color 0.4s var(--sv-ease),
      color 0.4s var(--sv-ease),
      border-color 0.4s var(--sv-ease);
  }

  .sv-about-{{ ai_gen_id }} .list-social.sv-socials .list-social__link .svg-wrapper,
  .sv-about-{{ ai_gen_id }} .list-social.sv-socials .list-social__link svg,
  .sv-about-{{ ai_gen_id }} .sv-social svg {
    width: var(--social-icon-size);
    height: var(--social-icon-size);
  }

  @media (hover: hover) {
    .sv-about-{{ ai_gen_id }} .list-social.sv-socials .list-social__link:hover,
    .sv-about-{{ ai_gen_id }} .sv-social:hover {
      transform: translateY(-2px);
      background-color: var(--sv-forest);
      border-color: var(--sv-forest);
      color: var(--sv-on-dark);
      box-shadow: none;
    }
  }

  .sv-about-{{ ai_gen_id }} .list-social.sv-socials .list-social__link:focus-visible,
  .sv-about-{{ ai_gen_id }} .sv-social:focus-visible {
    outline: 2px solid var(--sv-accent);
