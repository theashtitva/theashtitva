{% doc %}
  Premium About Us — Srivaya. Editorial layout, soft surfaces, homepage typography.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .sv-about-{{ ai_gen_id }} {
    --sv-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --sv-ink: #20181a;
    --sv-body: #61474d;
    --sv-accent: #6f4b53;
    --sv-accent-deep: #513c40;
    --sv-soft: #f6f1f2;
    --sv-pale: #ece4e6;
    --sv-line: #e3d6d9;
    --sv-white: #ffffff;
    display: block;
    width: 100%;
    color: var(--sv-body);
    background: var(--sv-white);
  }

  .sv-about-{{ ai_gen_id }} .sv-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s var(--sv-ease), transform 0.7s var(--sv-ease);
  }

  .sv-about-{{ ai_gen_id }} .sv-reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-about-{{ ai_gen_id }} .sv-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-wrap {
      padding-left: 48px;
      padding-right: 48px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
    font-family: var(--font-body-family, sans-serif);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-eyebrow--solo::before,
  .sv-about-{{ ai_gen_id }} .sv-eyebrow--solo::after {
    content: '';
    width: 28px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 45%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-eyebrow--left {
    justify-content: flex-start;
  }

  .sv-about-{{ ai_gen_id }} .sv-eyebrow--left::before {
    content: '';
    width: 28px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 45%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-heading {
    margin: 0;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-style: var(--font-heading-style, normal);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-heading {
      font-size: 40px;
    }
  }

  /* ——— Hero ——— */
  .sv-about-{{ ai_gen_id }} .sv-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    text-align: center;
    padding: 72px 24px 0;
    background:
      radial-gradient(ellipse 90% 80% at 50% -10%, color-mix(in srgb, var(--sv-soft) 95%, #fff) 0%, transparent 65%),
      linear-gradient(180deg, var(--sv-soft) 0%, var(--sv-white) 78%);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-hero {
      padding: 96px 48px 0;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-title {
    margin: 0 0 18px;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: 34px;
    line-height: 1.1;
    letter-spacing: -0.028em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-hero-title {
      font-size: 48px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-text {
    margin: 0 auto;
    max-width: 480px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--sv-body);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-hero-text {
      font-size: 18px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 28px auto 40px;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-rule span {
    width: 48px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 35%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-rule svg {
    width: 10px;
    height: 10px;
    opacity: 0.75;
  }

  /* Trust strip under hero */
  .sv-about-{{ ai_gen_id }} .sv-trust {
    max-width: 920px;
    margin: 0 auto;
    padding: 28px 8px 36px;
    border-top: 1px solid var(--sv-line);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-trust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 32px 0 48px;
      gap: 0;
    }

    .sv-about-{{ ai_gen_id }} .sv-trust-item:not(:last-child) {
      border-right: 1px solid var(--sv-line);
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-trust-item {
    text-align: center;
    padding: 0 12px;
  }

  .sv-about-{{ ai_gen_id }} .sv-trust-number {
    margin: 0 0 6px;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sv-ink);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-trust-number {
      font-size: 32px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-trust-label {
    margin: 0;
    font-size: 13px;
    line-height: 1.35;
    color: var(--sv-body);
  }

  /* ——— Story (editorial split) ——— */
  .sv-about-{{ ai_gen_id }} .sv-story {
    padding: 56px 0 64px;
    background: var(--sv-white);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-story {
      padding: 72px 0 88px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-story-grid {
    display: grid;
    gap: 28px;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-story-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
      gap: 56px;
      align-items: start;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-story-aside {
    position: sticky;
    top: 96px;
  }

  .sv-about-{{ ai_gen_id }} .sv-story .sv-heading {
    margin-bottom: 0;
  }

  .sv-about-{{ ai_gen_id }} .sv-story-lead {
    margin: 16px 0 0;
    max-width: 280px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-story-body {
    font-family: var(--font-body-family, sans-serif);
    font-size: 16px;
    line-height: 1.8;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-story-body p {
    margin: 0 0 18px;
  }

  .sv-about-{{ ai_gen_id }} .sv-story-body p:last-child {
    margin-bottom: 0;
  }

  /* ——— Why (4 features, no cards) ——— */
  .sv-about-{{ ai_gen_id }} .sv-why {
    padding: 64px 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, color-mix(in srgb, var(--sv-soft) 88%, #fff), transparent 70%),
      var(--sv-soft);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-why {
      padding: 80px 0;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-why-head {
    text-align: center;
    max-width: 520px;
    margin: 0 auto 40px;
  }

  .sv-about-{{ ai_gen_id }} .sv-why-head .sv-eyebrow {
    justify-content: center;
  }

  .sv-about-{{ ai_gen_id }} .sv-why-head .sv-eyebrow::before,
  .sv-about-{{ ai_gen_id }} .sv-why-head .sv-eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 45%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-why-head .sv-heading {
    margin-bottom: 12px;
  }

  .sv-about-{{ ai_gen_id }} .sv-why-intro {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    max-width: 880px;
    margin: 0 auto;
    border-top: 1px solid var(--sv-line);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-feature {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    align-items: start;
    padding: 28px 4px;
    border-bottom: 1px solid var(--sv-line);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-feature {
      padding: 32px 28px 32px 8px;
    }

    .sv-about-{{ ai_gen_id }} .sv-feature:nth-child(odd) {
      border-right: 1px solid var(--sv-line);
      padding-right: 36px;
    }

    .sv-about-{{ ai_gen_id }} .sv-feature:nth-child(even) {
      padding-left: 36px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-feature-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-feature-icon svg {
    width: 22px;
    height: 22px;
  }

  .sv-about-{{ ai_gen_id }} .sv-feature-title {
    margin: 0 0 6px;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--sv-ink);
  }

  .sv-about-{{ ai_gen_id }} .sv-feature-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--sv-body);
  }

  /* ——— Mission band ——— */
  .sv-about-{{ ai_gen_id }} .sv-mission {
    padding: 72px 24px;
    text-align: center;
    background: linear-gradient(180deg, var(--sv-white) 0%, var(--sv-soft) 45%, var(--sv-white) 100%);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-mission {
      padding: 96px 48px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-mission-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .sv-about-{{ ai_gen_id }} .sv-mission .sv-eyebrow {
    justify-content: center;
  }

  .sv-about-{{ ai_gen_id }} .sv-mission .sv-eyebrow::before,
  .sv-about-{{ ai_gen_id }} .sv-mission .sv-eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 45%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-mission-quote {
    margin: 0;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: 26px;
    font-style: italic;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-mission-quote {
      font-size: 34px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-mission-body {
    margin: 24px auto 0;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--sv-body);
  }

  /* ——— Founder ——— */
  .sv-about-{{ ai_gen_id }} .sv-founder {
    padding: 24px 0 56px;
    background: var(--sv-white);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-founder {
      padding: 8px 0 72px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-panel {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 28px 36px;
    background: var(--sv-soft);
    border-radius: 4px;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-founder-panel {
      padding: 48px 52px 44px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-label {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-quote {
    margin: 0 0 24px;
    font-family: var(--font-body-family, sans-serif);
    font-size: 16px;
    font-style: italic;
    line-height: 1.8;
    color: var(--sv-body);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-founder-quote {
      font-size: 17px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-attr {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--sv-accent-deep);
  }

  /* ——— Reassure (WhatsApp) ——— */
  .sv-about-{{ ai_gen_id }} .sv-reassure {
    padding: 64px 24px;
    text-align: center;
    background: var(--sv-soft);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-reassure {
      padding: 80px 48px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure .sv-eyebrow {
    justify-content: center;
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure .sv-eyebrow::before,
  .sv-about-{{ ai_gen_id }} .sv-reassure .sv-eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 45%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure-title {
    margin: 0 0 16px;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-reassure-title {
      font-size: 36px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-reassure-text {
    margin: 0 auto 28px;
    max-width: 520px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 50px;
    padding: 14px 28px;
    background: transparent;
    color: var(--sv-accent);
    border: 1px solid rgba(43, 43, 43, 0.28);
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--font-body-family, sans-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .sv-about-{{ ai_gen_id }} .sv-wa-btn svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  @media (hover: hover) {
    .sv-about-{{ ai_gen_id }} .sv-wa-btn:hover {
      background: var(--sv-accent);
      color: var(--sv-white);
      border-color: #312426;
    }
  }

  /* ——— Close: CTA + social ——— */
  .sv-about-{{ ai_gen_id }} .sv-close {
    text-align: center;
    padding: 72px 24px 88px;
    background:
      radial-gradient(ellipse 80% 70% at 50% 100%, color-mix(in srgb, var(--sv-soft) 90%, #fff) 0%, transparent 65%),
      linear-gradient(180deg, var(--sv-white) 0%, var(--sv-white) 40%, var(--sv-soft) 100%);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-close {
      padding: 96px 48px 110px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-close-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .sv-about-{{ ai_gen_id }} .sv-close .sv-eyebrow {
    justify-content: center;
    margin-bottom: 16px;
  }

  .sv-about-{{ ai_gen_id }} .sv-close .sv-eyebrow::before,
  .sv-about-{{ ai_gen_id }} .sv-close .sv-eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 45%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-close .sv-heading {
    margin-bottom: 14px;
  }

  .sv-about-{{ ai_gen_id }} .sv-close-text {
    max-width: 420px;
    margin: 0 auto 32px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-close-rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0 auto 28px;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-close-rule span {
    width: 40px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 35%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-close-rule svg {
    width: 10px;
    height: 10px;
    opacity: 0.7;
  }

  .sv-about-{{ ai_gen_id }} .sv-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    min-width: 220px;
    padding: 16px 32px;
    background: {{ block.settings.cta_button_bg | default: '#6f4b53' }};
    color: {{ block.settings.cta_button_text | default: '#ffffff' }};
    border: 1px solid rgba(43, 43, 43, 0.35);
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--font-body-family, sans-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .sv-about-{{ ai_gen_id }} .sv-cta-btn svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    transition: transform 0.3s var(--sv-ease);
  }

  @media (hover: hover) {
    .sv-about-{{ ai_gen_id }} .sv-cta-btn:hover {
      background: {{ block.settings.cta_button_hover | default: '#513c40' }};
      border-color: #312426;
    }

    .sv-about-{{ ai_gen_id }} .sv-cta-btn:hover svg {
      transform: translateX(3px);
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
    margin-top: 40px;
  }

  .sv-about-{{ ai_gen_id }} .sv-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--sv-white);
    border: 1px solid var(--sv-line);
    box-shadow: 0 6px 18px rgba(49, 36, 38, 0.07);
    color: var(--sv-accent);
    text-decoration: none;
    transition:
      opacity 0.3s ease,
      color 0.3s ease,
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s var(--sv-ease),
      transform 0.3s var(--sv-ease);
  }

  .sv-about-{{ ai_gen_id }} .sv-social svg {
    width: 22px;
    height: 22px;
  }

  @media (hover: hover) {
    .sv-about-{{ ai_gen_id }} .sv-social:hover {
      color: var(--sv-white);
      background: var(--sv-accent);
      border-color: var(--sv-accent);
      box-shadow: 0 10px 24px rgba(49, 36, 38, 0.12);
      transform: translateY(-2px);
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-social-note {
    margin: 12px 0 0;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--sv-body);
    opacity: 0.8;
  }
{% endstyle %}

<about-srivaya-{{ ai_gen_id }} class="sv-about-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <section class="sv-hero">
    <div class="sv-wrap">
      <div class="sv-hero-inner sv-reveal" data-sv-reveal>
        <p class="sv-eyebrow sv-eyebrow--solo">{{ block.settings.hero_eyebrow | default: 'About Us' }}</p>
