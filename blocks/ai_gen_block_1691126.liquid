{% doc %}
  @prompt
    Create a hero section image component with the following features:
    
    - Background: full-width image with separate mobile and desktop image upload options
    - Content layout: SubText (small label/eyebrow text) on top, then Heading, then CTA Button — stacked vertically
    - Positioning controls: horizontal alignment (left / center / right) and vertical alignment (top / center / bottom) for the content block, configurable separately for mobile and desktop
    - Full customization options:
      - Section height: separate px/vh settings for desktop and mobile
      - Heading: font size, font weight, color, line height — separate for desktop and mobile
      - SubText: font size, font weight, color, letter spacing — separate for desktop and mobile
      - CTA Button: label text, link URL, background color, text color, border radius, padding, font size
      - Content max-width control
      - Overlay color and opacity for readability
      - Text shadow toggle
    - All settings should be exposed as theme editor schema settings so they are fully editable in the Shopify theme customizer, add option to have padding as well to this text container where position is there
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-hero-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .ai-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-hero-content-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    z-index: 1;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
  }

  .ai-hero-subtext-{{ ai_gen_id }} {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    {% if block.settings.text_shadow_enabled %}
      text-shadow: 0 1px 2px rgba(7, 23, 19, 0.25);
    {% endif %}
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    margin: 0;
    font-family: var(--font-heading-family);
    white-space: pre-line;
    text-wrap: balance;
    {% if block.settings.text_shadow_enabled %}
      text-shadow: 0 2px 8px rgba(7, 23, 19, 0.28);
    {% endif %}
  }

  .ai-hero-description-{{ ai_gen_id }} {
    margin: 0;
    max-width: 34em;
    line-height: 1.65;
    {% if block.settings.text_shadow_enabled %}
      text-shadow: 0 1px 3px rgba(7, 23, 19, 0.22);
    {% endif %}
  }

  .ai-hero-actions-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.4rem;
  }

  .ai-hero-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.6rem;
    text-decoration: none;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    border: 1px solid {{ block.settings.button_bg_color }};
    cursor: pointer;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    transition:
      background-color 280ms cubic-bezier(0.22, 1, 0.36, 1),
      color 280ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ai-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color | default: '#0B2924' }};
    border-color: {{ block.settings.button_hover_bg_color | default: '#0B2924' }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-hero-button-secondary-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.6rem;
    text-decoration: none;
    background-color: transparent;
    color: {{ block.settings.secondary_button_text_color | default: '#F7F3E9' }};
    border-radius: {{ block.settings.button_border_radius }}px;
    border: 1px solid {{ block.settings.secondary_button_border_color | default: '#B89A5A' }};
    cursor: pointer;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    transition:
      background-color 280ms cubic-bezier(0.22, 1, 0.36, 1),
      color 280ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ai-hero-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_color }};
    border-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-hero-button-{{ ai_gen_id }},
    .ai-hero-button-secondary-{{ ai_gen_id }} {
      transition: none;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-hero-{{ ai_gen_id }} {
      height: {{ block.settings.desktop_height }}{{ block.settings.desktop_height_unit }};
      {% if block.settings.desktop_height_unit == 'px' %}
        min-height: min({{ block.settings.desktop_height }}px, 85vh);
        height: clamp(70vh, {{ block.settings.desktop_height }}px, 85vh);
      {% endif %}
    }

    .ai-hero-background-desktop-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-background-mobile-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-content-wrapper-{{ ai_gen_id }} {
      justify-content: {{ block.settings.desktop_horizontal_align }};
      align-items: {{ block.settings.desktop_vertical_align }};
      padding: {{ block.settings.desktop_content_padding }}px;
    }

    .ai-hero-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.desktop_subtext_size }}px;
      font-weight: {{ block.settings.desktop_subtext_weight }};
      color: {{ block.settings.desktop_subtext_color }};
      letter-spacing: {{ block.settings.desktop_subtext_letter_spacing }}px;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.desktop_heading_size }}px;
      font-weight: {{ block.settings.desktop_heading_weight }};
      color: {{ block.settings.desktop_heading_color }};
      line-height: {{ block.settings.desktop_heading_line_height }};
    }

    .ai-hero-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.desktop_description_size | default: 16 }}px;
      font-weight: 400;
      color: {{ block.settings.desktop_description_color | default: '#F7F3E9' }};
    }

    .ai-hero-button-{{ ai_gen_id }},
    .ai-hero-button-secondary-{{ ai_gen_id }} {
      padding: {{ block.settings.desktop_button_padding_vertical }}px {{ block.settings.desktop_button_padding_horizontal }}px;
      font-size: {{ block.settings.desktop_button_font_size }}px;
    }

    {% if block.settings.desktop_horizontal_align == 'center' %}
      .ai-hero-actions-{{ ai_gen_id }} {
        justify-content: center;
      }
      .ai-hero-content-{{ ai_gen_id }} {
        text-align: center;
      }
    {% elsif block.settings.desktop_horizontal_align == 'flex-end' %}
      .ai-hero-actions-{{ ai_gen_id }} {
        justify-content: flex-end;
      }
      .ai-hero-content-{{ ai_gen_id }} {
        text-align: right;
      }
    {% else %}
      .ai-hero-content-{{ ai_gen_id }} {
        text-align: left;
      }
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-hero-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}{{ block.settings.mobile_height_unit }};
      {% if block.settings.mobile_height_unit == 'px' %}
        height: clamp(68vh, {{ block.settings.mobile_height }}px, 82vh);
      {% endif %}
      min-height: 420px;
    }

    .ai-hero-background-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-background-mobile-{{ ai_gen_id }} {
      display: block;
      object-position: center 30%;
    }

    .ai-hero-content-wrapper-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_horizontal_align }};
      align-items: {{ block.settings.mobile_vertical_align }};
      padding: {{ block.settings.mobile_content_padding }}px;
    }

    .ai-hero-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subtext_size }}px;
      font-weight: {{ block.settings.mobile_subtext_weight }};
      color: {{ block.settings.mobile_subtext_color }};
      letter-spacing: {{ block.settings.mobile_subtext_letter_spacing }}px;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
      font-weight: {{ block.settings.mobile_heading_weight }};
      color: {{ block.settings.mobile_heading_color }};
      line-height: {{ block.settings.mobile_heading_line_height }};
    }

    .ai-hero-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_size | default: 14 }}px;
      color: {{ block.settings.mobile_description_color | default: '#F7F3E9' }};
    }

    .ai-hero-button-{{ ai_gen_id }},
    .ai-hero-button-secondary-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_button_padding_vertical }}px {{ block.settings.mobile_button_padding_horizontal }}px;
      font-size: {{ block.settings.mobile_button_font_size }}px;
    }

    {% if block.settings.mobile_horizontal_align == 'center' %}
      .ai-hero-actions-{{ ai_gen_id }} {
        justify-content: center;
      }
      .ai-hero-content-{{ ai_gen_id }} {
        text-align: center;
      }
    {% elsif block.settings.mobile_horizontal_align == 'flex-end' %}
      .ai-hero-actions-{{ ai_gen_id }} {
        justify-content: flex-end;
      }
      .ai-hero-content-{{ ai_gen_id }} {
        text-align: right;
      }
    {% else %}
      .ai-hero-content-{{ ai_gen_id }} {
        text-align: left;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {%- liquid
    assign hero_desktop = block.settings.desktop_image
    assign hero_mobile = block.settings.mobile_image
    assign use_theme_hero = false
    if hero_desktop == blank
      assign use_theme_hero = true
    endif
  -%}

  {% if use_theme_hero %}
    <img
      src="{{ 'ashtitva-hero-banner-clean.png' | asset_url }}"
      alt="{{ block.settings.heading | default: 'Ashtitva jewellery' | escape }}"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
      class="ai-hero-background-{{ ai_gen_id }} ai-hero-background-desktop-{{ ai_gen_id }}"
    >
    <img
      src="{{ 'ashtitva-hero-product.png' | asset_url }}"
      alt="{{ block.settings.heading | default: 'Ashtitva jewellery' | escape }}"
      loading="eager"
      fetchpriority="high"
      width="1000"
      height="1250"
      class="ai-hero-background-{{ ai_gen_id }} ai-hero-background-mobile-{{ ai_gen_id }}"
    >
  {% else %}
    {% if hero_desktop %}
      <img
        src="{{ hero_desktop | image_url: width: 2400 }}"
        srcset="{{ hero_desktop | image_url: width: 800 }} 800w, {{ hero_desktop | image_url: width: 1200 }} 1200w, {{ hero_desktop | image_url: width: 1600 }} 1600w, {{ hero_desktop | image_url: width: 2000 }} 2000w, {{ hero_desktop | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ hero_desktop.alt | default: block.settings.heading | default: 'Ashtitva jewellery' | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ hero_desktop.width }}"
        height="{{ hero_desktop.height }}"
        class="ai-hero-background-{{ ai_gen_id }} ai-hero-background-desktop-{{ ai_gen_id }}"
      >
    {% endif %}

    {% if hero_mobile %}
      <img
        src="{{ hero_mobile | image_url: width: 1200 }}"
        srcset="{{ hero_mobile | image_url: width: 600 }} 600w, {{ hero_mobile | image_url: width: 900 }} 900w, {{ hero_mobile | image_url: width: 1200 }} 1200w"
        sizes="100vw"
        alt="{{ hero_mobile.alt | default: block.settings.heading | default: 'Ashtitva jewellery' | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ hero_mobile.width }}"
        height="{{ hero_mobile.height }}"
        class="ai-hero-background-{{ ai_gen_id }} ai-hero-background-mobile-{{ ai_gen_id }}"
      >
    {% elsif hero_desktop %}
      <img
        src="{{ hero_desktop | image_url: width: 1200 }}"
        srcset="{{ hero_desktop | image_url: width: 600 }} 600w, {{ hero_desktop | image_url: width: 900 }} 900w, {{ hero_desktop | image_url: width: 1200 }} 1200w"
        sizes="100vw"
        alt="{{ hero_desktop.alt | default: block.settings.heading | default: 'Ashtitva jewellery' | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ hero_desktop.width }}"
        height="{{ hero_desktop.height }}"
        class="ai-hero-background-{{ ai_gen_id }} ai-hero-background-mobile-{{ ai_gen_id }}"
      >
    {% endif %}
  {% endif %}

  <div class="ai-hero-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-hero-content-wrapper-{{ ai_gen_id }}">
    <div class="ai-hero-content-{{ ai_gen_id }}">
      {% if block.settings.subtext != blank %}
        <p class="ai-hero-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h1 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="ai-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
      {% endif %}

      {% if block.settings.button_text != blank or block.settings.secondary_button_text != blank %}
        <div class="ai-hero-actions-{{ ai_gen_id }}">
          {% if block.settings.button_text != blank %}
            <a
              href="{{ block.settings.button_link | default: '/collections/all' }}"
              class="ai-hero-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_text }}
            </a>
          {% endif %}
          {% if block.settings.secondary_button_text != blank %}
            <a
              href="{{ block.settings.secondary_button_link | default: '/pages/about-us' }}"
              class="ai-hero-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.secondary_button_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Background images"
    },
    {
      "type": "checkbox",
      "id": "use_theme_hero_banner",
