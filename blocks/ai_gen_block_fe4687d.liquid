{% doc %}
  @prompt
    Create a fully customizable "Section Heading" block component with the following features:
    
    **Content:**
    - Heading text (plain text input)
    - Optional subtext/description below the heading
    - Optional eyebrow/label text above the heading
    
    **Alignment & Layout:**
    - Text alignment options: Left, Center, Right — configurable separately for desktop and mobile
    
    **Typography - Heading:**
    - Font size control for desktop (range: 16px–96px)
    - Font size control for mobile (range: 14px–64px)
    - Font weight options: Light (300), Regular (400), Medium (500), Semi-Bold (600), Bold (700)
    - Letter spacing control
    - Line height control
    - Text transform: None, Uppercase, Capitalize
    
    **Typography - Subtext:**
    - Font size control for desktop
    - Font size control for mobile
    - Font weight options
    - Text color (separate from heading color)
    
    **Colors:**
    - Heading text color
    - Subtext text color
    - Optional decorative accent/underline color
    
    **Spacing:**
    - Top and bottom padding (desktop)
    - Top and bottom padding (mobile)
    - Gap between heading and subtext
    
    **Decorative Options:**
    - Optional animated or static underline/accent line below heading
    - Underline width: Full, Auto, Fixed px
    
    The block should be responsive, use CSS custom properties for all configurable values, and be compatible with Shopify's Dawn theme. All settings should be accessible from the theme editor sidebar.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-section-heading-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top_desktop }}px;
    padding-bottom: {{ block.settings.padding_bottom_desktop }}px;
  }

  .ai-section-heading__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.gap_heading_subtext }}px;
    text-align: {{ block.settings.text_alignment_desktop }};
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-section-heading__eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_font_size_desktop }}px;
    font-weight: {{ block.settings.eyebrow_font_weight }};
    color: {{ block.settings.eyebrow_color }};
    margin: 0;
    text-transform: {{ block.settings.eyebrow_text_transform }};
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
  }

  .ai-section-heading__heading-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: inline-block;
    {% if block.settings.text_alignment_desktop == 'center' %}
      margin: 0 auto;
    {% elsif block.settings.text_alignment_desktop == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-section-heading__heading-{{ ai_gen_id }} {
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-style: var(--font-heading-style, normal);
    font-size: {{ block.settings.heading_font_size_desktop }}px;
    font-weight: {{ block.settings.heading_font_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0;
    text-transform: {{ block.settings.heading_text_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: {{ block.settings.heading_line_height }};
    text-wrap: balance;
  }

  {% if block.settings.show_underline %}
    .ai-section-heading__underline-{{ ai_gen_id }} {
      height: {{ block.settings.underline_thickness }}px;
      background-color: {{ block.settings.underline_color }};
      margin-top: {{ block.settings.underline_spacing }}px;
      {% if block.settings.underline_width == 'full' %}
        width: 100%;
      {% elsif block.settings.underline_width == 'auto' %}
        width: 100%;
      {% else %}
        width: {{ block.settings.underline_width_px }}px;
        {% if block.settings.text_alignment_desktop == 'center' %}
          margin-left: auto;
          margin-right: auto;
        {% elsif block.settings.text_alignment_desktop == 'right' %}
          margin-left: auto;
        {% endif %}
      {% endif %}
      {% if block.settings.underline_animated %}
        transform-origin: left;
        animation: ai-section-heading-underline-grow-{{ ai_gen_id }} 0.8s ease-out forwards;
      {% endif %}
    }

    {% if block.settings.underline_animated %}
      @keyframes ai-section-heading-underline-grow-{{ ai_gen_id }} {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
    {% endif %}
  {% endif %}

  .ai-section-heading__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_font_size_desktop }}px;
    font-weight: {{ block.settings.subtext_font_weight }};
    color: {{ block.settings.subtext_color }};
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-section-heading-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-section-heading__container-{{ ai_gen_id }} {
      text-align: {{ block.settings.text_alignment_mobile }};
    }

    .ai-section-heading__eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_font_size_mobile }}px;
    }

    .ai-section-heading__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size_mobile }}px;
    }

    .ai-section-heading__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_font_size_mobile }}px;
    }

    .ai-section-heading__heading-wrapper-{{ ai_gen_id }} {
      {% if block.settings.text_alignment_mobile == 'center' %}
        margin: 0 auto;
      {% elsif block.settings.text_alignment_mobile == 'right' %}
        margin-left: auto;
        margin-right: 0;
      {% else %}
        margin-left: 0;
        margin-right: auto;
      {% endif %}
    }

    {% if block.settings.show_underline %}
      .ai-section-heading__underline-{{ ai_gen_id }} {
        {% if block.settings.text_alignment_mobile == 'center' %}
          margin-left: auto;
          margin-right: auto;
        {% elsif block.settings.text_alignment_mobile == 'right' %}
          margin-left: auto;
          margin-right: 0;
        {% else %}
          margin-left: 0;
          margin-right: auto;
        {% endif %}
      }
    {% endif %}
  }
{% endstyle %}

<section-heading-{{ ai_gen_id }} class="ai-section-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-section-heading__container-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank %}
      <p class="ai-section-heading__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</p>
    {% endif %}

    {% if block.settings.heading_text != blank %}
      <div class="ai-section-heading__heading-wrapper-{{ ai_gen_id }}">
        <h2 class="ai-section-heading__heading-{{ ai_gen_id }}">{{ block.settings.heading_text }}</h2>
        {% if block.settings.show_underline %}
          <div class="ai-section-heading__underline-{{ ai_gen_id }}"></div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <p class="ai-section-heading__subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
    {% endif %}
  </div>
</section-heading-{{ ai_gen_id }}>

<script>
  (function() {
    class SectionHeading{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        {% if block.settings.underline_animated %}
          this.setupIntersectionObserver();
        {% endif %}
      }

      setupIntersectionObserver() {
        const underline = this.querySelector('.ai-section-heading__underline-{{ ai_gen_id }}');
        if (!underline) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              underline.style.animation = 'ai-section-heading-underline-grow-{{ ai_gen_id }} 0.8s ease-out forwards';
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.5
        });

        observer.observe(this);
      }
    }

    customElements.define('section-heading-{{ ai_gen_id }}', SectionHeading{{ ai_gen_id }});
  })();
</script>

